PORT=5000
MONGO_URI=mongodb://localhost:27017/admin_panel
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_SECRET=your_encryption_secret_here
NODE_ENV=development
# Default Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Admin
# Email Configuration (Nodemailer)
# If using Gmail, generate an App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com

# Stripe Payment Gateway Configuration (Backend only)
# Get your API keys from https://dashboard.stripe.com/apikeys
# WARNING: NEVER expose STRIPE_SECRET_KEY to the frontend client
STRIPE_SECRET_KEY=sk_test_51U0eDuGLhdC667ZPIJsMiP1f0lMBEvby6dSZrjVLUqwt7AV8TK5WhddunyWNlSCtL5YKk2BRBXFSv78FxFcm012T00cG9Mlr3j
# Optional Stripe Publishable Key (can be used on frontend client for Stripe Elements)
STRIPE_PUBLISHABLE_KEY=pk_test_51U0eDuGLhdC667ZPb9iWViNm8JqD0UmItEVwSn8L6GaagSWsRdsyWXkVTktLahl71Ib58yrjzfuIG4cpZFt1pBUE00bPtXfCU9
