{
  "name": "admin-panel-backend",
  "version": "1.0.0",
  "description": "Beginner friendly Express and MongoDB backend project",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"nodemon server.js\" \"npm run dev --prefix frontend\"",
    "seed:roles": "node seeders/roleSeeder.js",
    "seed:admin": "node seeders/adminSeeder.js",
    "seed:products": "node -e \"require('./config/db')().then(async () => { await require('./seeders/productSeeder')(); process.exit(0); });\"",
    "test:delivery": "node tests/deliveryZoneAndOrderTests.js",
    "test:socket": "node tests/socketIOTest.js",
    "android:sync": "npm run cap:sync --prefix frontend",
    "android:open": "npm run cap:open --prefix frontend"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "rest-api",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.3",
    "socket.io": "^4.8.4",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.3",
    "socket.io-client": "^4.8.4"
  }
}
